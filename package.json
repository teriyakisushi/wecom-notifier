{
  "name": "wecom-notifier",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Composite Action that sends customizable GitHub event notifications to WeCom group webhooks.",
  "type": "module",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "dev": "node src/cli.mjs",
    "smoke": "node dist/index.mjs --dry-run --event-name push --event tests/fixtures/events/push.json",
    "preview": "node scripts/preview-custom.mjs",
    "preview:i": "node scripts/preview-interactive.mjs",
    "lint:syntax": "node scripts/lint.mjs",
    "lint:templates": "node scripts/lint-templates.mjs --strict",
    "test:coverage": "node scripts/check-coverage.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teriyakiushi/wecom-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/teriyakiushi/wecom-notifier/issues"
  },
  "homepage": "https://github.com/teriyakiushi/wecom-notifier#readme",
  "coverageThreshold": {
    "lines": 85,
    "branches": 75,
    "functions": 85
  }
}
